generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String         @id @default(cuid())
  name               String
  nextAttendantIndex Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  buttonConfig       ButtonConfig?
  attendants         Attendant[]
  customers          Customer[]
}

model ButtonConfig {
  id                  String   @id @default(cuid())
  accountId           String   @unique
  account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  position            String   @default("RIGHT") // LEFT or RIGHT
  size                String   @default("LARGE") // LARGE or SMALL
  primaryColor        String   @default("#25D366") // Default WhatsApp color
  buttonText          String   @default("Chat with us")
  balloonText         String   @default("Olá! Preencha seus dados para iniciarmos seu atendimento pelo WhatsApp.")
  allowedOrigins      String   @default("*") // Comma-separated origins or * for public widgets
  gclidExpirationDays Int      @default(30)
  conversionName      String   @default("WhatsApp Conversion")
  gaEventName         String   @default("whatsapp_form_submit")
  formFields          String   @default("name,email,phone")
  googleAdsCustomerId  String?
  googleAdsRefreshToken String? // AES-256-GCM encrypted ciphertext
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Attendant {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

model Customer {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  gclid          String?
  gbraid         String?
  wbraid         String?
  utm_source     String?
  utm_campaign   String?
  utm_medium     String?
  name           String?
  email          String?
  phone          String?
  conversionTime DateTime @default(now())
  value          Float    @default(0.0)
  currency       String   @default("BRL")
  status         String?
  conversionName String

  // Google Ads enrichment fields
  enrichment_status          String?
  enrichment_error           String?
  campaign_id                String?
  campaign_name              String?
  ad_group_id                String?
  ad_group_name              String?
  gclid_keyword              String?
  gclid_match_type           String?
  gclid_ad_id                String?
  gclid_click_date           String?
  gclid_ad_network_type      String?
  gclid_page_number          Int?
  gclid_geo_interest_country String?
  gclid_geo_interest_region  String?
  gclid_geo_presence_country String?
  gclid_geo_presence_region  String?

  @@index([accountId, conversionTime])
  @@index([accountId, email])
  @@index([accountId, phone])
  @@index([accountId, enrichment_status])
}
